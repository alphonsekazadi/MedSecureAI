# Auth0 Configuration for MedSecureAI
# Replace these values with your Auth0 tenant settings

# Auth0 Domain (your medical tenant)
VITE_AUTH0_DOMAIN=my-ai-agent.us.auth0.com

# Auth0 Client ID
VITE_AUTH0_CLIENT_ID=aYWhsRapYLzuVVNWhT5iJmpb9H9Di69B

# Auth0 Audience (API identifier)
VITE_AUTH0_AUDIENCE=https://api.medsecureai.com

# Redirect URI after authentication
VITE_AUTH0_REDIRECT_URI=https://medsecureai.vercel.app

# Auth0 AI Advanced Features (for challenge demo)
VITE_ENABLE_TOKEN_VAULT=true
VITE_ENABLE_ASYNC_AUTH=true
VITE_ENABLE_FGA=true

# AI API Configuration - Multiple Options Available

# Option 1: Hugging Face (Currently Active)
# Using a working model that supports text generation
VITE_HF_API_KEY=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
VITE_AI_PROVIDER=huggingface
VITE_HUGGINGFACE_MODEL=swiss-ai/Apertus-8B-Instruct-2509

# Option 2: Groq (Alternative - get free API key)
# VITE_GROQ_API_KEY=your_groq_api_key_here
# VITE_AI_PROVIDER=groq
# VITE_AI_MODEL=llama-3.1-70b-versatile

# Option 3: Mock AI (Fallback for demos)
# VITE_AI_PROVIDER=mock
# VITE_AI_MODEL=medical-assistant
# VITE_AI_MODEL=command

# Option 4: OpenAI (If available)
# VITE_OPENAI_API_KEY=your_openai_api_key
# VITE_AI_PROVIDER=openai
# VITE_AI_MODEL=gpt-3.5-turbo

# Auth0 Advanced AI Features Configuration

# Token Vault Configuration (for third-party API access)
# Enable in Auth0 Dashboard: Applications > [App] > Advanced > Grant Types > Token Vault
VITE_AUTH0_TOKEN_VAULT_ENABLED=true

# Custom API Client for Token Vault exchanges
# Create in Auth0 Dashboard: Applications > APIs > Create API > Custom API Client
VITE_AUTH0_CUSTOM_API_CLIENT_ID=your_custom_api_client_id
VITE_AUTH0_CUSTOM_API_CLIENT_SECRET=your_custom_api_client_secret

# Asynchronous Authorization (CIBA) Configuration
# Enable in Auth0 Dashboard: Applications > [App] > Advanced > Grant Types > CIBA
VITE_AUTH0_CIBA_ENABLED=true

# Fine-Grained Authorization Configuration
# Setup Auth0 FGA for medical data access control
VITE_AUTH0_FGA_ENABLED=true
VITE_AUTH0_FGA_STORE_ID=your_fga_store_id

# Google Integration for Calendar API (Token Vault demo)
# Configure in Auth0 Dashboard: Authentication > Social > Google
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.readonly

# Medical API Configuration
VITE_MEDICAL_API_AUDIENCE=https://api.medsecureai.com/medical
VITE_MEDICAL_API_URL=https://api.medsecureai.com

# Application Configuration
VITE_APP_NAME=MedSecureAI
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Advanced Features Feature Flags
VITE_ENABLE_TOKEN_VAULT=true
VITE_ENABLE_ASYNC_AUTH=true
VITE_ENABLE_FGA=true
VITE_ENABLE_CALENDAR_INTEGRATION=true