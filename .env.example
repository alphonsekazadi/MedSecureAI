# MedSecureAI Environment Configuration
# Copy this file to .env and update with your actual credentials

# =============================================================================
# Auth0 Configuration (Required)
# =============================================================================
# Get these from your Auth0 Dashboard → Applications → MedSecureAI

# Your Auth0 domain (format: your-tenant.us.auth0.com)
VITE_AUTH0_DOMAIN=my-ai-agent.us.auth0.com

# Your Auth0 application Client ID
VITE_AUTH0_CLIENT_ID=your_client_id_here

# Auth0 API Audience (for API authorization)
VITE_AUTH0_AUDIENCE=https://medsecureai-api

# Auth0 callback URL for development
VITE_AUTH0_REDIRECT_URI=http://localhost:5173

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Choose your primary AI provider: 'huggingface', 'groq', or 'mock'
VITE_AI_PROVIDER=huggingface

# =============================================================================
# HuggingFace Configuration (Recommended)
# =============================================================================
# Get your API token from: https://huggingface.co/settings/tokens

# Your HuggingFace API token
VITE_HF_API_KEY=hf_your_token_here

# HuggingFace model (PublicAI provider model)
VITE_HUGGINGFACE_MODEL=swiss-ai/Apertus-8B-Instruct-2509

# Alternative models you can try:
# VITE_HUGGINGFACE_MODEL=swiss-ai/Apertus-70B-Instruct-2509
# VITE_HUGGINGFACE_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT

# =============================================================================
# Groq Configuration (Alternative)
# =============================================================================
# Get your API key from: https://console.groq.com/keys

# Your Groq API key (optional, if using Groq as provider)
VITE_GROQ_API_KEY=gsk_your_key_here

# Groq model selection
VITE_AI_MODEL=llama-3.1-70b-versatile

# Alternative Groq models:
# VITE_AI_MODEL=llama3-8b-8192
# VITE_AI_MODEL=mixtral-8x7b-32768

# =============================================================================
# Application Configuration
# =============================================================================

# Environment (development, production, staging)
NODE_ENV=development

# Application URL (for production deployment)
VITE_APP_URL=http://localhost:5173

# =============================================================================
# Security Configuration (Optional)
# =============================================================================

# Enable additional logging for debugging (true/false)
VITE_DEBUG_MODE=false

# Medical compliance mode (always keep true for production)
VITE_HIPAA_COMPLIANCE=true

# =============================================================================
# Instructions
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Update the values above with your actual credentials
# 3. Never commit the .env file to version control
# 4. For production, use your platform's environment variable settings
# 
# Auth0 Setup:
# - Create a Single Page Application in Auth0
# - Enable "Auth0 for AI Agents" features in your Auth0 tenant
# - Set up user roles: Patient, Doctor, Admin
# - Configure callback URLs and CORS settings
#
# AI Provider Setup:
# - HuggingFace: Create account, generate API token, use PublicAI models
# - Groq: Create account, generate API key, access Llama models  
# - Mock: Use 'mock' provider for development without API keys
#
# For detailed setup instructions, see README.md